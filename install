#!/usr/bin/env bash

DOTFILES=$(cd $(dirname "${BASH_SOURCE[0]}") && pwd)
WIN_HOME=/mnt/c/Users/${USER^}

# remove any previous directories or files
# create the symlink
# ln -s $DOTFILES/nvim to (destination directory eg. $HOME/.config/nvim)

# INFO: WSL

################
# Bash aliases #
################
unlink $HOME/.bash_aliases
ln -s $DOTFILES/bash/aliases.sh $HOME/.bash_aliases

#################
# Neovim / nvim #
#################
unlink $HOME/.config/nvim
ln -s $DOTFILES/nvim $HOME/.config/nvim

#######
# Git #
#######
unlink $HOME/.config/git
ln -s $DOTFILES/.config/git $HOME/.config/git

###########
# Lazygit #
###########
unlink $HOME/.config/lazygit
ln -s $DOTFILES/.config/lazygit $HOME/.config/lazygit
cp $DOTFILES/.config/lazygit/config.yml $WIN_HOME/AppData/Local/lazygit/config.yml

############
# OpenCode #
############
mkdir -p $HOME/.config/opencode/skills
unlink $HOME/.config/opencode/skills/commit-msg
ln -s $DOTFILES/.config/opencode/skills/commit-msg $HOME/.config/opencode/skills/commit-msg
unlink $HOME/.config/opencode/opencode.json
unlink $HOME/.config/opencode/tui.json
unlink $HOME/.config/opencode/plugins/env-protection.js
ln -s $DOTFILES/.config/opencode/opencode.json $HOME/.config/opencode/opencode.json
ln -s $DOTFILES/.config/opencode/tui.json $HOME/.config/opencode/tui.json
ln -s $DOTFILES/.config/opencode/plugins/env-protection.js $HOME/.config/opencode/plugins/env-protection.js
cp -r $DOTFILES/.config/opencode/* $WIN_HOME/.config/opencode

###########
# Windows #
###########
rm -f $MY_WIN_HOME/.config/wezterm/wezterm.lua $WIN_HOME/.config/wezterm/my_keys.lua
cp -r $DOTFILES/wezterm/ $WIN_HOME/.config/

mkdir -p $WIN_HOME/.config/git
cp $DOTFILES/.config/git/.gitignore $WIN_HOME/.config/git/.gitignore
sed '/^\[credential\]/,/^\[/ { /^\[/!d; /^\[credential\]/d }' \
  $DOTFILES/.config/git/config > $WIN_HOME/.config/git/config

# PowerShell
cp $DOTFILES/microWindows/profile.ps1 /mnt/z/Mario/Documents/PowerShell/Microsoft.PowerShell_profile.ps1

# rm -rf $HOME/.config/phpactor
# ln -s $DOTFILES/phpactor $HOME/.config/phpactor

