{
    "$schema": "https://opencode.ai/v2/cli.json",
    "animations": true,
    "keybinds": {
        "input.submit": "alt+return",
        "input.newline": "return,shift+return,ctrl+return,ctrl+j",
        "session.first": "ctrl+home",
        "session.last": "ctrl+end",
        "session.message.next": "alt+right",
        "session.message.previous": "alt+left",
        "input.word.forward": "alt+f,ctrl+right",
        "input.word.backward": "alt+b,ctrl+left"
    },
    "prompt": {
        "paste": "full"
    },
    "scroll": {
        "acceleration": true
    },
    "session": {
        "scrollbar": true,
        "thinking": "show"
    }
}
